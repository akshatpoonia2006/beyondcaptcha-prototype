# =====================================================================
# BeyondCAPTCHA Prototype - Environment Configuration Example
# Copy this file to .env or set environment variables in your shell.
# =====================================================================

# Secret key for Flask session signing (auto-generated if unset)
SECRET_KEY=your_ephemeral_or_production_secret_key_here

# Administrative credentials for protected audit endpoints
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_API_KEY=your_custom_admin_api_key_here

# Cryptographic salt for data-minimized salted SHA-256 IP hashing
IP_SALT=your_custom_cryptographic_salt_here

# SQLite Database path
DB_PATH=beyondcaptcha_prototype.db

# Demo mode toggle (true/false)
DEMO_MODE=true
